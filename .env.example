# Nech prázdné pro Docker volume. Pokud chceš databázi v konkrétním
# adresáři na SSD, zkopíruj soubor jako .env a nastav absolutní cestu:
# SETLISTER_DATA_PATH=/mnt/ssd/setlister
SETLISTER_DATA_PATH=setlister-data

# Volitelné nastavení read-only Gmail asistenta:
SETLISTER_BASE_URL=http://localhost:8110
SETLISTER_ADMIN_EMAIL=propadleek@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
GMAIL_LOOKBACK_DAYS=730
